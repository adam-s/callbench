# Copy to .env and fill. Never commit the filled copy.
#
# Increment 1 buys the number and confirms which of these the transport
# adapter actually needs — until then this file is a placeholder shape, not a
# contract. See docs/drivers.md.

# --- Twilio (transport) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number the bench calls FROM. Owned, not a verified personal line.
TWILIO_FROM_NUMBER=

# --- Targets ---
# The loopback number the maintainer owns (the simulator answers it). Every dial
# before the first live run (Increment 7) targets ONLY this.
CALLBENCH_LOOPBACK_NUMBER=
# The system under test. Every dial to this number is human-approved, one call
# at a time (invariant, AGENTS.md). First dialed at Increment 7 (first live run).
CALLBENCH_TARGET_NUMBER=

# --- Models (Modal-served, OpenAI-compatible) ---
# STT and TTS run on Modal behind OpenAI-compatible endpoints; the adapters reach
# each with a base URL. See docs/models.md and infra/modal/. Get these URLs from
# `infra/modal/manage.sh urls` after a deploy. The live speech path needs these.
# STT: the base is the URL as-is (route is /v1/audio/transcriptions).
MODAL_STT_URL=
# TTS (Kokoro): the base is the URL as-is (route is /v1/audio/speech).
MODAL_TTS_URL=
# LLM (the live PERSONA, Increment 6/8): the OpenAI base is this URL + /v1. Not
# deployed yet. NOTE: the judge does NOT use this — it runs via the `claude:`
# runner (`claude -p`), so no Modal LLM is needed to grade.
MODAL_LLM_URL=
# Modal endpoints are private-by-workspace; if an endpoint is set to require a
# key, put it here. The `openai:` runner sends it as the bearer token.
MODAL_API_KEY=

# --- Live-run pre-flight (scripts/preflight.ts) ---
# Hard caps a run declares before it starts (enforced in code, @callbench/runplan).
# All optional — the pre-flight defaults them. concurrency is fixed at 1.
CALLBENCH_MAX_CALLS=
CALLBENCH_MAX_MINUTES=
CALLBENCH_RUNS_EACH=

# --- Web UI (apps/web) ---
# Where the UI reads frozen run artifacts. Unset = the committed fixtures under
# apps/web/fixtures/runs. A live runner would write to a data/ dir and point here.
CALLBENCH_RUNS_DIR=

# --- Debug ---
# true | false. Unset = on outside production/test. Toggleable at runtime.
DEBUG_LOGGING=
