# Copy to .env and fill. Never commit the filled copy.
#
# Increment 1 buys the number and confirms which of these the transport
# adapter actually needs — until then this file is a placeholder shape, not a
# contract. See docs/drivers.md.

# --- Twilio (transport) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number the bench calls FROM. Owned, not a verified personal line.
TWILIO_FROM_NUMBER=

# --- Targets ---
# The loopback number the maintainer owns (the simulator answers it). Every dial
# before the first live run (Increment 7) targets ONLY this.
CALLBENCH_LOOPBACK_NUMBER=
# The system under test. Every dial to this number is human-approved, one call
# at a time (invariant, AGENTS.md). First dialed at Increment 7 (first live run).
CALLBENCH_TARGET_NUMBER=

# --- Models (Modal-served, OpenAI-compatible) ---
# Everything runs on Modal behind OpenAI-compatible endpoints; the bench reaches
# each through the `openai:` runner with a base URL. See docs/models.md and
# infra/modal/. Get these URLs from `infra/modal/manage.sh urls` after a deploy.
# STT: the base is the URL as-is (route is /v1/audio/transcriptions).
MODAL_STT_URL=
# TTS (Kokoro): the base is the URL as-is (route is /v1/audio/speech).
MODAL_TTS_URL=
# LLM (persona / bootstrap judge): the OpenAI base is this URL + /v1. Not
# deployed yet — fill when the persona or judge needs it.
MODAL_LLM_URL=
# Modal endpoints are private-by-workspace; if an endpoint is set to require a
# key, put it here. The `openai:` runner sends it as the bearer token.
MODAL_API_KEY=

# --- Debug ---
# true | false. Unset = on outside production/test. Toggleable at runtime.
DEBUG_LOGGING=
